c6c2a-3010-01c9-8295-4d988333f15d/a09132f0-8e57-47c9-bd04-501786157958/og-image%5B1%5D.png"}]},"summary":{"value":"<p>My personal website build with <a href=\"https://www.gatsbyjs.com/\">Gatsby</a> and <a href=\"https://app.kontent.ai\">Kentico Kontent</a> as a data source.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"JS/TS","codename":"js_ts"},{"name":"Kontent.ai","codename":"kontent_ai"},{"name":"Jamstack","codename":"jamstack"}]}}},{"__typename":"kontent_item_project","system":{"id":"381de423-398d-55d9-8de4-1965aadcd115","codename":"photon_landing_page_starter_for_gatsby"},"elements":{"title":{"value":"Gatsby.js Photon starter"},"url_slug":{"value":"gatsby-js-photon-starter"},"release_date":{"value":"2019-05-20T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/f3aee23b-1826-4389-9f8a-9d5285c1a415/photon-cover.PNG"}]},"summary":{"value":"<p>Kentico Kontent web template using Gatsby.js and Kentico Kontent based on <a href=\"https://www.gatsbyjs.org/starters/codebushi/gatsby-starter-photon/\">Gatsby starter Photon</a>.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[]}}},{"__typename":"kontent_item_project","system":{"id":"4981819f-7904-5645-879c-a03a18e0dd93","codename":"project_ckeditor5_plotly_widget_showcase"},"elements":{"title":{"value":"CKEditor & Plotly.js Widget Showcase"},"url_slug":{"value":"ckeditor5-plotly-widget-showcase"},"release_date":{"value":"2025-07-03T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/0963777b-98d3-45aa-8011-7ea9d490fb15/ckeditor5-plotly-widget-showcase.jpg"}]},"summary":{"value":"<p>Interactive Plotly.js charts living inside CKEditor 5 content: scatter, bar, line, pie, and histogram widgets with hover, zoom, and responsive resizing - a proof that rich data visualization and rich text editing can share one document.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"JS/TS","codename":"js_ts"}]}}},{"__typename":"kontent_item_project","system":{"id":"b9fa98ba-72e9-5a7a-b823-ef1c97c6dc9a","codename":"project_ckeditor5_smart_callout"},"elements":{"title":{"value":"CKEditor 5 Smart Callout Plugin"},"url_slug":{"value":"ckeditor5-smart-callout"},"release_date":{"value":"2025-06-24T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/d91d0d99-9684-4189-9b3d-48cc1f8fbaec/ckeditor5-smart-callout.jpg"}]},"summary":{"value":"<p>A CKEditor 5 callout-box plugin generated with Claude Code - an early experiment in letting an AI coding agent build a complete editor plugin, deployed live on Netlify.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"751ed3ae-5953-5f7d-8132-7d7c78fbe9ac","codename":"project_ckeditor_ai_playground"},"elements":{"title":{"value":"CKEditor AI Playground"},"url_slug":{"value":"ckeditor-ai-playground"},"release_date":{"value":"2025-10-06T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/23b38904-48d4-4c90-b189-35f3a3b50196/ckeditor-ai-playground.jpg"}]},"summary":{"value":"<p>My personal sandbox for CKEditor AI experiments, deployed on Vercel - the repo I reach for when a demo idea needs a quick home with the AI assistant already wired in.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"295d5b13-4207-5b83-9d94-b5b890237afe","codename":"project_ckeditor_image_optimizer_demo"},"elements":{"title":{"value":"CKEditor Image Optimizer Demo (Uploadcare)"},"url_slug":{"value":"ckeditor-image-optimizer-demo"},"release_date":{"value":"2025-10-09T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/10e3aa29-c94c-406c-9e53-712355001d0b/ckeditor-image-optimizer-demo.jpg"}]},"summary":{"value":"<p>The demo project behind my Image Optimizer webinar: CKEditor 5 with the Uploadcare-powered image workflow - upload, transform, and deliver optimized images without leaving the editor.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"Web","codename":"web"}]}}},{"__typename":"kontent_item_project","system":{"id":"43730b83-8fee-520d-9baa-91e2613edc2a","codename":"project_ckeditor_theme_playground"},"elements":{"title":{"value":"CKEditor Theme Playground"},"url_slug":{"value":"ckeditor-theme-playground"},"release_date":{"value":"2025-10-20T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/824015a3-0b8d-4aed-a8dc-08e7f73fbf63/ckeditor-theme-playground.jpg"}]},"summary":{"value":"<p>A small sandbox for experimenting with CKEditor 5 theming: tweak the editor's look with CSS custom properties and see how far the UI can bend before you need a custom build.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"Web","codename":"web"}]}}},{"__typename":"kontent_item_project","system":{"id":"2f64d7dc-f05a-5761-b60c-7ef35aca0cd4","codename":"project_devrel_ckeditor_ai_coding_agents_demo"},"elements":{"title":{"value":"Trailhead: the CKEditor AI Coding Agents Webinar Demo"},"url_slug":{"value":"devrel-ckeditor-ai-coding-agents-demo"},"release_date":{"value":"2026-09-17T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/5c88d0f8-8a9a-4c03-b0c2-dcf05a363890/devrel-ckeditor-ai-coding-agents-demo.jpg"}]},"summary":{"value":"<p>The runnable companion to the \\\"Less time, fewer tokens, better effects\\\" webinar: a fictional trip-planning landing page whose About section is edited by a CKEditor InlineEditor that an AI coding agent wired in - Format painter, Slash commands, AI assistant, autosave and all.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"c17541d4-bddb-522d-92fc-0f8b8a1d28f1","codename":"project_devrel_ckeditor_ai_onprem_docker_showcase"},"elements":{"title":{"value":"CKEditor AI On-Premises Docker Showcase"},"url_slug":{"value":"devrel-ckeditor-ai-onprem-docker-showcase"},"release_date":{"value":"2026-04-09T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/1fd08814-8ded-456a-8978-ac8f9eef1ffc/devrel-ckeditor-ai-onprem-docker-showcase.jpg"}]},"summary":{"value":"<p>A complete local CKEditor AI environment in Docker Compose: every backend service, your own LLM hookup, and MCP tool registration - the hands-on setup behind my on-premises webinar and Shorts.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"7f0effde-3af8-5537-bc52-703a3aa5828a","codename":"project_devrel_ckeditor_ai_showcase_react"},"elements":{"title":{"value":"CKEditor AI Showcase (React)"},"url_slug":{"value":"devrel-ckeditor-ai-showcase-react"},"release_date":{"value":"2025-11-29T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/3df90854-c5e5-476f-8fa5-13c5712386c4/devrel-ckeditor-ai-showcase-react.jpg"}]},"summary":{"value":"<p>An interactive React demo of CKEditor AI configuration and customization: AI Chat, Quick Actions, and Review Mode explored through five hands-on tasks in a realistic content management interface.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"48d1415a-7456-5648-be41-af2e2887c0b6","codename":"project_devrel_ckeditor_raffle"},"elements":{"title":{"value":"CKEditor Raffle"},"url_slug":{"value":"devrel-ckeditor-raffle"},"release_date":{"value":"2025-09-18T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/d77888f4-342e-4a81-b7a4-624473ef0bb9/devrel-ckeditor-raffle.jpg"}]},"summary":{"value":"<p>The booth raffle tool: a web-based winner picker with slot-machine spin, confetti, and cryptographically fair selection - names come from a local text file, nothing gets stored or tracked.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"DevRel","codename":"devrel"},{"name":"Web","codename":"web"}]}}},{"__typename":"kontent_item_project","system":{"id":"9e1f36c6-9e0c-5d98-8dcc-9db47cc53c90","codename":"project_devrel_collaboration_features_decomposed"},"elements":{"title":{"value":"CKEditor Collaboration Features Decomposed"},"url_slug":{"value":"devrel-collaboration-features-decomposed"},"release_date":{"value":"2026-01-28T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/0bdbeb61-dd95-4016-8876-82990f53acf6/devrel-collaboration-features-decomposed.jpg"}]},"summary":{"value":"<p>A bare-bones TypeScript project that adds CKEditor's collaboration features one at a time - comments, track changes, revision history, real-time collaboration - each in its minimal possible setup.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"}]}}},{"__typename":"kontent_item_project","system":{"id":"65f1fc56-825f-552a-bbbb-b73576e65249","codename":"project_devrel_mlh_workshops_aug_2025"},"elements":{"title":{"value":"CKEditor 5 Sample for MLH Global Hack Week (Aug 2025)"},"url_slug":{"value":"devrel-mlh-workshops-aug-2025"},"release_date":{"value":"2025-07-30T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/08cfec57-486d-4857-9d28-7336613dc884/devrel-mlh-workshops-aug-2025.jpg"}]},"summary":{"value":"<p>The sample project behind CKEditor's MLH Global Hack Week challenges: starter setup, TypeScript migration, template functionality, and CKInspector integration - built for beginners taking their first steps in editor customization.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"DevRel","codename":"devrel"}]}}},{"__typename":"kontent_item_project","system":{"id":"e3104f30-dbdf-536b-a74d-2af9130bbbe2","codename":"project_drupalcon_chicago_26_ckeditor_ai_playground"},"elements":{"title":{"value":"CKEditor 5 Timestamp Plugin for Drupal: Vibe-Coded at DrupalCon Chicago 2026"},"url_slug":{"value":"drupalcon-chicago-26-ckeditor-ai-playground"},"release_date":{"value":"2026-04-01T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/58ed1df7-d636-49d4-92f2-428f2b0f20a8/drupalcon-chicago-26-ckeditor-ai-playground.jpg"}]},"summary":{"value":"<p>My first custom Drupal module extending CKEditor, vibe-coded with Claude Code on the DrupalCon Chicago conference floor - a toolbar button that inserts the current timestamp, plus the agent skill that knows how to build CKEditor 5 plugins as Drupal modules.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"CMS","codename":"cms"},{"name":"AI","codename":"ai"}]}}},{"__typename":"kontent_item_project","system":{"id":"a90d4faf-577c-50b6-b139-fad515cfadbd","codename":"project_mermaid_showcase"},"elements":{"title":{"value":"Mermaid Diagram Showcase"},"url_slug":{"value":"mermaid-showcase"},"release_date":{"value":"2026-08-12T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/a556008e-4dc6-4138-a880-f15581739924/mermaid-showcase.jpg"}]},"summary":{"value":"<p>A living gallery of Mermaid diagrams rendered natively by GitHub - including the OAuth flow diagrams from my article on securing CKEditor real-time collaboration.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"Web","codename":"web"}]}}},{"__typename":"kontent_item_project","system":{"id":"81109979-ba97-591e-a61b-d7ec281a98c9","codename":"project_ondrejs_notes"},"elements":{"title":{"value":"Ondrej's Notes: One Note App, Seven Rich Text Editors"},"url_slug":{"value":"ondrejs-notes"},"release_date":{"value":"2025-05-23T00:00:00Z"},"image":{"value":[{"url":"https://assets-eu-01.kc-usercontent.com:443/6aec6c2a-3010-01c9-8295-4d988333f15d/ded60bc5-9038-414e-8370-30384184b243/ondrejs-notes.jpg"}]},"summary":{"value":"<p>A Google Keep-inspired note app (React + TypeScript + Vite) that doubles as an editor comparison lab: switch a note between CKEditor, Tiptap, TinyMCE, Lexical, Froala, Quill, or a plain textarea and feel the differences yourself.</p>"},"channel_purpose":{"value":[{"codename":"website"}]},"listing_category":{"value":[{"name":"CKEditor","codename":"ckeditor"},{"name":"JS/TS","codename":"js_ts"}]}}},{"__typename":"kontent_item_project","system":{"id":"112ab6ca-97e3-59fa-b219-f199053fdc19","codename":"project_proactive_digital_twin_workshop"},"elements":{"title":{"value":"Proactive Digital Twin Workshop"},"url_slug":{"value":"proactive-digital-twin-workshop"},"release_date":{"value":"2026-07-02T00:00:00Z"},"imag